# ==============================================================================
# Megalider - .gitignore (Next.js 16+ / TypeScript / Node)
# ==============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build & Cache
/.next/
/out/
/build
/dist
/.turbo

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Environment Variables & Secrets
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
*.pem
*.key
*.cert

# Vercel & Deployment
.vercel
.serverless

# Testing & Coverage
/coverage
/.nyc_output
/playwright-report
/test-results

# Logs & Debugging
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# IDEs & Code Editors
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# Operating System Files
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# AI Agents, Scratch & Local Temporary Files
.gemini/
scratch/
