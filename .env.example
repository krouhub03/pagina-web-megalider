# ==========================================
# CIGARRERÍA MEGALIDER - CONFIGURACIÓN DE ENTORNO
# ==========================================

# 1. Base de datos PostgreSQL (Hermes IA / Contabilidad)
POSTGRES_DATABASE_URL="postgres://usuario:password@localhost:5432/megalider_hermes?sslmode=prefer"

# 2. Base de datos MySQL (Usuarios / Tienda / Catálogo)
MYSQL_DATABASE_URL="mysql://usuario:password@localhost:3306/megalider_tienda"

# 3. Autenticación JWT (jose)
NEXTAUTH_SECRET="tu_clave_secreta_jwt_muy_segura_aqui"
NEXTAUTH_URL="http://localhost:3000"

# 4. Google OAuth 2.0 (Para inicio de sesión y registro con Google)
GOOGLE_CLIENT_ID="tu_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu_google_client_secret"

# 5. Google reCAPTCHA v2 (Protección anti-bot en Registro)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="tu_recaptcha_site_key_aqui"
RECAPTCHA_SECRET_KEY="tu_recaptcha_secret_key_aqui"
